{
  "name": "discord-mod-bot",
  "version": "1.0.0",
  "description": "Discord bot for moderating messages using AI",
  "type": "module",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "test": "bun test",
    "build": "bun run typecheck",
    "typecheck": "bun node_modules/@typescript/native/bin/tsc -b",
    "lint": "bun scripts/lint.ts",
    "lint:prune": "bun scripts/lint.ts --prune",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EkuboProtocol/discord-mod-bot.git"
  },
  "keywords": [
    "discord",
    "moderation",
    "bot",
    "ai"
  ],
  "author": "EkuboProtocol",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/EkuboProtocol/discord-mod-bot/issues"
  },
  "homepage": "https://github.com/EkuboProtocol/discord-mod-bot#readme",
  "dependencies": {
    "discord.js": "^14.14.1",
    "effect": "4.0.0-rc.112",
    "openai": "^4.20.1",
    "winston": "^3.11.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/yargs": "^17.0.33",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "^7.0.2004"
  }
}
