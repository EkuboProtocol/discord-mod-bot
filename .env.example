# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_SERVER_ID=your_server_id_here

# Channel Configuration
# Leave empty to moderate all channels
# For specific channels, use comma-separated IDs
MODERATED_CHANNELS=

# Channels to exclude from moderation
# Use comma-separated IDs for multiple channels
EXCLUDED_CHANNELS=

# Welcome channel to exclude from moderation (automated messages)
WELCOME_CHANNEL_ID=

# Notification Configuration
# Channel ID to send moderation action notifications to
NOTIFICATION_CHANNEL_ID=

# Role Configuration
# Comma-separated role IDs to exclude from moderation
EXCLUDED_ROLES=

# Timeout Configuration
# Duration in minutes to timeout users when content with medium severity is detected (0 to disable)
# Note: Low severity content only gets deleted, high severity content triggers automatic ban
TIMEOUT_DURATION=5

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo  # OpenAI model to use, gpt-4 recommended for better detection

# Message Filtering
IGNORED_PHRASES=gm  # Comma-separated list of phrases to ignore (won't be sent to OpenAI)
CONTEXT_MESSAGE_COUNT=5  # Number of previous messages to include for context

# Logging
LOG_LEVEL=info  # error, warn, info, debug

# Moderation Severity Levels (Configuration through AI system)
# The bot now uses a three-tier severity system for spam/scam detection:
# - HIGH: Obvious scams (discord invites, support ticket links, phishing). Results in immediate ban.
# - MEDIUM: Generic spam (unsolicited support, job requests, etc). Results in timeout for TIMEOUT_DURATION.
# - LOW: Borderline spam (self-promotion, etc). Message is deleted but no timeout is applied.