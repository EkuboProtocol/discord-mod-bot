# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_SERVER_ID=your_server_id_here

# Channel Configuration
# Leave empty to moderate all channels
# For specific channels, use comma-separated IDs
MODERATED_CHANNELS=

# Notification Configuration
# Channel ID to send moderation action notifications to
NOTIFICATION_CHANNEL_ID=

# Role Configuration
# Comma-separated role IDs to exclude from moderation
EXCLUDED_ROLES=

# Timeout Configuration
# Duration in minutes to timeout users when their message is deleted (0 to disable)
TIMEOUT_DURATION=5

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo  # OpenAI model to use

# Message Filtering
IGNORED_PHRASES=gm  # Comma-separated list of phrases to ignore (won't be sent to OpenAI)
CONTEXT_MESSAGE_COUNT=5  # Number of previous messages to include for context

# Logging
LOG_LEVEL=info  # error, warn, info, debug